<%- include('partials/header') %>
<div class="page-head"><h1>Импорт</h1></div>
<% if (msg) { %><div class="notice"><%= msg %></div><% } %>

<div class="grid-2">
  <section class="card">
    <h2>Загрузить JSON</h2>
    <p class="muted small">Файл в формате сборщика: <code>{ "run": {...}, "vacancies": [...] }</code>. Формат описан в README.</p>
    <form id="upload-form" class="stack-form">
      <input type="file" id="upload-file" accept=".json,application/json" multiple>
      <button class="btn">Импортировать</button>
    </form>
    <pre id="upload-result" class="result" hidden></pre>
  </section>

  <section class="card">
    <h2>Папка data/inbox</h2>
    <p class="muted small">Сборщик кладёт файлы сюда, приложение подхватывает их само раз в минуту.</p>
    <% if (!inbox.length) { %><p class="muted">Папка пуста.</p><% } else { %>
      <ul class="plain"><% inbox.forEach(f => { %><li><code><%= f %></code></li><% }) %></ul>
    <% } %>
    <form method="post" action="/import/inbox"><button class="btn btn-ghost">Обработать сейчас</button></form>
  </section>
</div>

<section class="card">
  <h2>История сборов</h2>
  <% if (!runs.length) { %><p class="muted">Пока пусто.</p><% } else { %>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>#</th><th>Импорт</th><th>Источник</th><th>Файл</th><th>Запрос</th><th class="num">Найдено</th><th class="num">Новых</th><th class="num">Обновл.</th><th class="num">Дублей</th><th class="num">Ошибок</th></tr></thead>
    <tbody>
    <% runs.forEach(r => { %>
      <tr>
        <td><%= r.id %></td><td><%= fmt.date(r.imported_at) %></td><td><%= r.source %></td>
        <td class="small"><%= r.file_name || '' %></td>
        <td class="small"><%= r.query ? (r.query.keywords || r.query.q || JSON.stringify(r.query)) : '' %></td>
        <td class="num"><%= r.found %></td><td class="num"><%= r.inserted %></td><td class="num"><%= r.updated %></td>
        <td class="num"><%= r.duplicates %></td><td class="num <%= r.errors ? 'danger' : '' %>" title="<%= r.notes || '' %>"><%= r.errors %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>
</section>
<%- include('partials/footer') %>
